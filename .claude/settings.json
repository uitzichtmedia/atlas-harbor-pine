      "Read(**/*.env)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(./secrets/**)",
      "Read(**/secrets/**)",
      "Read(**/*service-account*.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Edit(ledger.json)",
      "Edit(evidence/**)",
      "Edit(health.json)",
      "Edit(docs/**)",
      "Edit(governance/PRINCIPLES.md)",
      "Edit(governance/AUTHORITY.md)",
      "Edit(governance/STOP)",
      "Edit(governance/check-governance.mjs)",
      "Edit(.claude/**)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(export)",
      "Bash(set)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(sudo *)",
      "Bash(rm *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git config *)",
      "Bash(git remote *)",
      "Bash(node -e *)",
      "Bash(node --eval *)",
      "Bash(node -p *)"
    ]
  }
}
