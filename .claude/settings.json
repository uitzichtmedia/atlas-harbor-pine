{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit(site/content/products/**)",
      "Edit(snapshots/**)",
      "Edit(briefings/**)",
      "Edit(governance/DECISIONS.md)",
      "Edit(governance/CURRENT.md)",
      "Bash(node site/build.mjs)",
      "Bash(node site/build.mjs *)",
      "Bash(node ops/ledger.mjs *)",
      "Bash(node ops/collect-site.mjs)",
      "Bash(node ops/collect-site.mjs *)",
      "Bash(node ops/collect-gsc.mjs)",
      "Bash(node ops/collect-gsc.mjs *)",
      "Bash(node ops/verify-live.mjs *)",
      "Bash(node ops/health.mjs)",
      "Bash(node ops/health.mjs *)",
      "Bash(node ops/brief-check.mjs *)",
      "Bash(node --test)",
      "Bash(node --test *)",
      "Bash(node governance/check-governance.mjs *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git pull --ff-only *)",
      "Bash(git pull --rebase origin main)",
      "Bash(git push origin HEAD:main)"
    ],
    "ask": [
      "Edit(ops/**)",
      "Edit(site/build.mjs)",
      "Edit(tests/**)",
      "Edit(atlas.config.json)",
      "Edit(governance/STRATEGY.md)",
      "Edit(governance/BUSINESS-MODEL.md)",
